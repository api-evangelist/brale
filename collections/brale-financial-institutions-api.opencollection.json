                "name": "fi_id",
                "value": "",
                "type": "path",
                "description": "Financial Institution ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.brale.xyz/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
